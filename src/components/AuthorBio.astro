---
import { getAuthorById } from "../utils/helpers";
import { authorPath } from "../utils/helpers";

interface Props {
  authorId: string;
}
const { authorId } = Astro.props;

const authorEntry = await getAuthorById(authorId);
if (!authorEntry) return;

const author = authorEntry.data;
const avatar = author.avatar;

const initials = author.name
  .split(" ")
  .map((w: string) => w[0])
  .join("")
  .toUpperCase();

const firstName = author.name.split(" ")[0];
const hasExternalLink = author.externalUrl && author.externalUrl.length > 0;
---

<div class="authorbox">
  {avatar ? (
    <img src={avatar} alt={author.name} class="av av--img" />
  ) : (
    <span class="av">{initials}</span>
  )}
  <div>
    <div class="eyebrow">About the author</div>
    <h4>{author.name}</h4>
    <p>{author.bio}</p>
    <div class="links">
      {hasExternalLink && (
        <a href={author.externalUrl} rel="nofollow">Website ↗</a>
      )}
      <a href={authorPath(authorEntry.id)}>More by {firstName} →</a>
    </div>
  </div>
</div>
