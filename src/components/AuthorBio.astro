---
import { siteConfig } from "../../site.config";
import { authorPath } from "../utils/helpers";

interface Props {
  authorId: string;
}
const { authorId } = Astro.props;
const author = siteConfig.authors[authorId as keyof typeof siteConfig.authors];
if (!author) return;

const initials = author.name
  .split(" ")
  .map((w: string) => w[0])
  .join("")
  .toUpperCase();

const firstName = author.name.split(" ")[0];
const hasExternalLink = author.externalUrl && author.externalUrl.length > 0;
---

<div class="authorbox">
  <span class="av">{initials}</span>
  <div>
    <div class="eyebrow">About the author</div>
    <h4>{author.name}</h4>
    <p>{author.bio}</p>
    <div class="links">
      {hasExternalLink && (
        <a href={author.externalUrl} rel="nofollow">Website ↗</a>
      )}
      <a href={authorPath(author.slug)}>More by {firstName} →</a>
    </div>
  </div>
</div>
