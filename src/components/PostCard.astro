---
import type { Post } from '../utils/helpers';
import { categoryPath, readingTime, getAuthorById } from '../utils/helpers';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const mins = readingTime(post.body);
const authorEntry = await getAuthorById(data.author);
const authorName = authorEntry?.data.name || data.author;
---

<article class="card">
  <a href={`/blog/${post.id}/`} aria-label={data.title}>
    {data.hero_image ? (
      <img src={data.hero_image} alt={data.title} loading="lazy" />
    ) : (
      <div class="ph"></div>
    )}
  </a>
  <span class="kicker">
    <a href={categoryPath(data.category)}>{data.category}</a>
  </span>
  <h3><a href={`/blog/${post.id}/`}>{data.title}</a></h3>
  <p>{data.description}</p>
  <div class="meta">By <b>{authorName}</b> · {mins} min read</div>
</article>
