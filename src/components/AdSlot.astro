---
import { siteConfig } from "../../site.config";

interface Props {
  unit?: "display" | "inArticle" | "multiplex";
}
const { unit = "display" } = Astro.props;

const pubId = siteConfig.adsense.publisherId;
const slotId = siteConfig.adsense.slots[unit];
const isActive = pubId && !pubId.includes("XXXX") && slotId && !slotId.includes("XXXX");
---

{isActive && (
  <div class="adslot">
    <span class="ad-label">Advertisement</span>
    <ins
      class="adsbygoogle"
      style={unit === "inArticle" ? "display:block;text-align:center;" : "display:block"}
      data-ad-client={pubId}
      data-ad-slot={slotId}
      {...(unit === "inArticle" ? { "data-ad-layout": "in-article", "data-ad-format": "fluid" } : {})}
      {...(unit === "multiplex" ? { "data-ad-format": "autorelaxed" } : {})}
      {...(unit === "display" ? { "data-ad-format": "auto", "data-full-width-responsive": "true" } : {})}
    />
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}
