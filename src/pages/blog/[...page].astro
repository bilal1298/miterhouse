---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getSortedPosts } from "../../utils/helpers";
import { siteConfig } from "../../../site.config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: siteConfig.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage > 1 ? `${siteConfig.name} Journal — Page ${page.currentPage}` : `${siteConfig.name} Journal`}
  description={`Every ${siteConfig.niche} guide we've published — real costs, real steps, newest first.`}
  noindex={page.currentPage > 1}
>
  <div class="wrap">
    <section class="page-head">
      <p class="eyebrow">All Articles</p>
      <h1>{siteConfig.name} Journal</h1>
      <p>Every guide we've published, newest first.</p>
    </section>

    {page.data.length > 0 ? (
      <div class="grid3">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="muted" style="text-align:center;padding:3rem 0;">Posts are on the way. Check back soon.</p>
    )}

    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
  </div>
</BaseLayout>
