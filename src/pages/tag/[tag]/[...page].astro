---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getSortedPosts, uniqueTags, getAllTags } from "../../../utils/helpers";
import { siteConfig } from "../../../../site.config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  const allTags = await getAllTags();
  const tagMap = new Map(allTags.map((t) => [t.id, t.data.name]));

  const usedTagSlugs = uniqueTags(posts);
  return usedTagSlugs.flatMap((tagSlug) => {
    const filtered = posts.filter((p) => p.data.tags.includes(tagSlug));
    const tagName = tagMap.get(tagSlug) || tagSlug;
    return paginate(filtered, {
      params: { tag: tagSlug },
      props: { tagName, totalPosts: filtered.length },
      pageSize: siteConfig.postsPerPage,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { tagName, totalPosts } = Astro.props;
---

<BaseLayout
  title={page.currentPage > 1 ? `#${tagName} — Page ${page.currentPage} — ${siteConfig.name}` : `#${tagName} — ${siteConfig.name}`}
  description={`All ${siteConfig.name} articles tagged with ${tagName}.`}
  noindex={page.currentPage > 1}
>
  <div class="wrap">
    <section class="page-head">
      <p class="eyebrow">Tag</p>
      <h1>#{tagName}</h1>
      <p class="muted" style="margin-top:.75rem;font-family:var(--label);font-size:.85rem;">
        {totalPosts} {totalPosts === 1 ? "article" : "articles"}
      </p>
    </section>

    {page.data.length > 0 ? (
      <div class="grid3">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="muted" style="text-align:center;padding:3rem 0;">No articles with this tag yet.</p>
    )}

    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
  </div>
</BaseLayout>
