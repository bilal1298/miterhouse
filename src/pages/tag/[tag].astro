---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getSortedPosts, uniqueTags, slugify } from "../../utils/helpers";
import { siteConfig } from "../../../site.config";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = uniqueTags(posts);
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      tag,
      posts: posts.filter((p) =>
        p.data.tags.map((t) => slugify(t)).includes(slugify(tag))
      ),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag} — ${siteConfig.name}`}
  description={`All ${siteConfig.name} articles tagged with ${tag}.`}
>
  <div class="wrap">
    <section class="page-head">
      <p class="eyebrow">Tag</p>
      <h1>#{tag}</h1>
      <p class="muted" style="margin-top:.75rem;font-family:var(--label);font-size:.85rem;">
        {posts.length} {posts.length === 1 ? "article" : "articles"}
      </p>
    </section>

    {posts.length > 0 ? (
      <div class="grid3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="muted" style="text-align:center;padding:3rem 0;">No articles with this tag yet.</p>
    )}
  </div>
</BaseLayout>
