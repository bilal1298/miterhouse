---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." noindex>
  <div class="wrap">
    <section class="page-head" style="padding-block:5rem">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p>It may have moved or never existed. Try the homepage instead.</p>
      <p style="margin-top:1.5rem">
        <a class="btn" href="/">Back home</a>
      </p>
    </section>
  </div>
</BaseLayout>
