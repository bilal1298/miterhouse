---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getSortedPosts, getAllCategories } from "../../../utils/helpers";
import { siteConfig } from "../../../../site.config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  const categories = await getAllCategories();
  return categories.flatMap((cat) => {
    const filtered = posts.filter((p) => p.data.category === cat.id);
    return paginate(filtered, {
      params: { category: cat.id },
      props: { categoryName: cat.data.name, categoryDescription: cat.data.description, totalPosts: filtered.length },
      pageSize: siteConfig.postsPerPage,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { categoryName, categoryDescription, totalPosts } = Astro.props;
const description = categoryDescription ||
  `Browse all ${categoryName.toLowerCase()} guides on ${siteConfig.name}.`;
---

<BaseLayout
  title={page.currentPage > 1 ? `${categoryName} — Page ${page.currentPage} — ${siteConfig.name}` : `${categoryName} — ${siteConfig.name}`}
  description={description}
  noindex={page.currentPage > 1}
>
  <div class="wrap">
    <section class="page-head">
      <p class="eyebrow">Category</p>
      <h1>{categoryName}</h1>
      <p>{description}</p>
      <p class="muted" style="margin-top:.75rem;font-family:var(--label);font-size:.85rem;">
        {totalPosts} {totalPosts === 1 ? "article" : "articles"}
      </p>
    </section>

    {page.data.length > 0 ? (
      <div class="grid3">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="muted" style="text-align:center;padding:3rem 0;">No articles in this category yet.</p>
    )}

    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
  </div>
</BaseLayout>
