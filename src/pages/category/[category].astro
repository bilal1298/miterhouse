---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getSortedPosts, uniqueCategories, slugify } from "../../utils/helpers";
import { siteConfig } from "../../../site.config";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return siteConfig.categories.map((cat) => ({
    params: { category: slugify(cat) },
    props: {
      category: cat,
      posts: posts.filter((p) => p.data.category === cat),
    },
  }));
}

const { category, posts } = Astro.props;
const description =
  (siteConfig.categoryDescriptions as Record<string, string>)[category] ||
  `Browse all ${category.toLowerCase()} guides on ${siteConfig.name}.`;
---

<BaseLayout
  title={`${category} — ${siteConfig.name}`}
  description={description}
>
  <div class="wrap">
    <section class="page-head">
      <p class="eyebrow">Category</p>
      <h1>{category}</h1>
      <p>{description}</p>
      <p class="muted" style="margin-top:.75rem;font-family:var(--label);font-size:.85rem;">
        {posts.length} {posts.length === 1 ? "article" : "articles"}
      </p>
    </section>

    {posts.length > 0 ? (
      <div class="grid3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="muted" style="text-align:center;padding:3rem 0;">No articles in this category yet.</p>
    )}
  </div>
</BaseLayout>
