---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../../site.config";
---

<BaseLayout
  title={`Write for Us — ${siteConfig.name}`}
  description={`Contribute a guest post to ${siteConfig.name}. We publish practical, expert home improvement content.`}
>
  <div class="wrap">
    <article class="prose" style="padding-top:3rem">
      <h1>Write for Us</h1>

      <p>
        Have hands-on experience with home improvement projects? {siteConfig.name} welcomes
        guest contributions from contractors, interior designers, remodelers, and experienced
        DIYers who want to share practical tips, project insights, and real-world advice with
        our community of homeowners.
      </p>

      <h2>Why Contribute to {siteConfig.name}?</h2>

      <ul>
        <li><strong>Reach an engaged audience</strong> — our readers are DIYers and budget-conscious homeowners actively planning their next project</li>
        <li><strong>Build your authority</strong> — position yourself as a trusted voice in the home improvement space</li>
        <li><strong>Get a permanent dofollow backlink</strong> — every published post includes an author bio with a link back to your site</li>
        <li><strong>Dedicated author profile</strong> — your own page on {siteConfig.name} showcasing all your contributions</li>
      </ul>

      <h2>Topics We Accept</h2>

      <p>
        Guest posts covering any of our core topics are welcome:
      </p>

      <ul>
        {siteConfig.categories.map((cat) => <li>{cat}</li>)}
      </ul>

      <p>
        We're especially interested in step-by-step how-to guides, honest cost breakdowns
        from real projects, tool and material comparisons with practical trade-offs, and
        project planning advice that helps homeowners make informed decisions.
      </p>

      <h2>Submission Requirements</h2>

      <ul>
        <li>1,200–2,500 words of original, unpublished content</li>
        <li>Clear H2/H3 headings with short, scannable paragraphs</li>
        <li>Practical, conversational tone — write like you're explaining to a neighbor</li>
        <li>Up to 2 relevant outbound links (subject to editorial review)</li>
        <li>100% original work — no republished, spun, or unedited AI-generated content</li>
        <li>No fabricated statistics, invented studies, or made-up cost figures</li>
        <li>No keyword stuffing or thinly veiled promotional pieces</li>
      </ul>

      <h2>How to Submit</h2>

      <p>
        Send your submission to{" "}
        <a href={`mailto:${siteConfig.email}?subject=Guest Post Submission – [Your Topic]`}>
          {siteConfig.email}
        </a>{" "}
        with the subject line <strong>Guest Post Submission – [Your Topic]</strong>. Please include:
      </p>

      <ul>
        <li>Your completed article (Google Doc or Word format preferred)</li>
        <li>A short bio (2–3 sentences) and a link to your website</li>
        <li>Any relevant images (royalty-free, minimum 1200×630px)</li>
      </ul>

      <p>
        Our editorial team will review your submission and get back to you within
        5–7 business days.
      </p>
    </article>
  </div>
</BaseLayout>
