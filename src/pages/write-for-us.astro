---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../../site.config";
---

<BaseLayout
  title={`Write for Us — ${siteConfig.name}`}
  description={`Contribute a guest post to ${siteConfig.name}. We publish practical, expert home improvement content.`}
>
  <div class="wrap">
    <article class="prose" style="padding-top:3rem">
      <h1>Write for Us</h1>

      <p>
        {siteConfig.name} accepts guest posts from home improvement professionals,
        contractors, interior designers, and experienced DIYers. Each published post
        includes a permanent byline and a dofollow link in your author bio.
      </p>

      <h2>What You Get</h2>

      <ul>
        <li>A permanent dofollow backlink in your author bio</li>
        <li>A dedicated author profile page on {siteConfig.name}</li>
        <li>Exposure to our audience of DIYers and budget-conscious homeowners</li>
      </ul>

      <h2>Content Guidelines</h2>

      <ul>
        <li>In-depth how-to guides with real steps and specific details</li>
        <li>Honest cost breakdowns based on actual project experience</li>
        <li>Tool and material comparisons with practical trade-offs</li>
        <li>Project planning guides that help homeowners make informed decisions</li>
        <li>Minimum 1,200 words with genuine depth — not filler to hit a count</li>
        <li>Original writing only; no republished, spun, or unedited AI content</li>
        <li>No fabricated statistics, invented studies, or made-up prices</li>
      </ul>

      <h2>How It Works</h2>

      <p>
        Email{" "}
        <a href={`mailto:${siteConfig.email}?subject=Guest Post Inquiry`}>
          {siteConfig.email}
        </a>{" "}
        with the subject line <strong>Guest Post Inquiry</strong>. Let us know your
        topic and a link to your site or previously published work. We'll reply within
        5 business days with next steps and pricing.
      </p>
    </article>
  </div>
</BaseLayout>
