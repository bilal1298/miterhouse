---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import { siteConfig } from "../../site.config";

const gp = siteConfig.guestPost;
const nicheTitle = siteConfig.niche.replace(/\b\w/g, (c) => c.toUpperCase());
const mailto = `mailto:${siteConfig.email}?subject=${encodeURIComponent("Sponsored Guest Post Inquiry")}`;

const faqs = [
  {
    q: "How much does a sponsored guest post cost?",
    a: `Our sponsored publication rates are shared upon inquiry. Please contact ${siteConfig.email} for pricing and submission details.`,
  },
  {
    q: "How many external links can I include?",
    a: `Up to ${gp.maxExternalLinks} relevant external links are permitted per article, subject to editorial approval. This includes links in the author bio.`,
  },
  {
    q: "How long does publication take?",
    a: `Editorial review takes ${gp.reviewTime} after we receive the completed article. Publication follows approval.`,
  },
  {
    q: "How do I submit my article?",
    a: "Google Docs with viewer access enabled is preferred. Word documents (.docx) are also accepted.",
  },
  {
    q: "When is payment due?",
    a: `Payment is due within ${gp.paymentWindowHours} hours after publication.`,
  },
  {
    q: "Do you accept free guest posts?",
    a: `No. ${siteConfig.name} currently accepts sponsored guest post submissions only.`,
  },
  {
    q: "Do you offer dofollow backlinks?",
    a: 'Sponsored links are appropriately marked using rel="sponsored" or rel="nofollow", in accordance with applicable search engine guidelines.',
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title={`Write for Us — Sponsored ${nicheTitle} Guest Posts`}
  description={`Publish a sponsored ${siteConfig.niche} guest post on ${siteConfig.name}. Guidelines, accepted topics, link policy, and how to inquire about sponsored rates.`}
>
  <JsonLd data={faqJsonLd} />

  <div class="wrap wfu">
    <header class="page-head">
      <div class="eyebrow">Sponsored guest posts</div>
      <h1>Write for Us</h1>
      <p>
        Publish a practical, genuinely useful {siteConfig.niche} article in front of
        {" "}{gp.readers} who are planning their next project.
      </p>
      <div class="wfu-head-cta">
        <a class="btn" href={mailto}>Inquire About Sponsored Posts</a>
        <a class="wfu-head-cta__email" href={mailto}>{siteConfig.email}</a>
      </div>
    </header>

    <section class="wfu-top" aria-labelledby="opportunities">
      <div class="wfu-intro">
        <h2 id="opportunities">Sponsored Guest Post Opportunities</h2>
        <p>Interested in publishing your content on {siteConfig.name}?</p>
        <p>
          We welcome sponsored guest post submissions from businesses, brands, marketing
          agencies, SEO professionals, and industry experts in the home improvement,
          renovation, DIY, and interior design niches.
        </p>
        <p>
          Our editors review each submission and maintain editorial control over everything
          we publish, which keeps the site useful for readers and worth being featured on.
        </p>
        <div class="wfu-note">
          <strong>Good to know before you pitch:</strong> we accept sponsored guest posts
          only. We don't offer paid writing assignments, and we don't provide free
          guest-post placements.
        </div>
      </div>

      <aside class="wfu-package" aria-labelledby="package">
        <div class="kicker">Sponsored publication</div>
        <h3 id="package">Our sponsored publication package includes:</h3>
        <ul class="wfu-package__list">
          <li>{gp.wordCount} words of original, high-quality content</li>
          <li>Up to {gp.maxExternalLinks} relevant external links, subject to editorial approval</li>
          <li>A short author bio and relevant brand mention</li>
          <li>Long-term publication, subject to editorial and payment terms</li>
          <li>Editorial review within {gp.reviewTime}</li>
        </ul>
        <div class="wfu-package__ask">
          <p class="wfu-package__q">Interested in publishing with us?</p>
          <p>Contact our editorial team for sponsored publication rates and submission details.</p>
        </div>
        <a class="btn wfu-package__btn" href={mailto}>Inquire About Sponsored Posts</a>
        <p class="wfu-package__email">
          Email: <a href={mailto}>{siteConfig.email}</a>
        </p>
      </aside>
    </section>

    <div class="prose wfu-body">
      <section aria-labelledby="included">
        <h2 id="included"><span class="hr"></span>What's Included?</h2>
        <div class="wfu-grid">
          <div class="wfu-cell">
            <h3>Publication on {siteConfig.name}</h3>
            <p>Your approved article published on the site, formatted to match our editorial style.</p>
          </div>
          <div class="wfu-cell">
            <h3>Up to {gp.maxExternalLinks} external links</h3>
            <p>Contextually relevant links, subject to editorial approval and appropriately qualified.</p>
          </div>
          <div class="wfu-cell">
            <h3>Author bio</h3>
            <p>A short bio with one relevant author or company link, counted within the link limit.</p>
          </div>
          <div class="wfu-cell">
            <h3>Long-term placement</h3>
            <p>Approved articles are intended to remain published long-term, subject to editorial and payment terms.</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="topics">
        <h2 id="topics"><span class="hr"></span>Accepted Topics</h2>
        <p>We publish home improvement guest posts across these subjects:</p>
        <ul class="wfu-topics">
          {gp.topics.map((topic) => <li>{topic}</li>)}
        </ul>
      </section>

      <section aria-labelledby="guidelines">
        <h2 id="guidelines"><span class="hr"></span>Content Guidelines</h2>
        <p>
          The best sponsored articles read like something a reader would bookmark. Before
          you submit, make sure yours meets these requirements:
        </p>
        <ul>
          <li>{gp.wordCount} words</li>
          <li>Original, unpublished content</li>
          <li>Informative, practical, and genuinely useful to {gp.readers}</li>
          <li>A natural, conversational writing style</li>
          <li>Clear H2 and H3 headings</li>
          <li>No keyword stuffing, spun content, or fabricated statistics</li>
          <li>Promotional content kept limited and naturally integrated</li>
        </ul>
      </section>

      <section aria-labelledby="links">
        <h2 id="links"><span class="hr"></span>External Link Policy</h2>
        <ul>
          <li>Up to {gp.maxExternalLinks} relevant external links per article, including any link in the author bio.</li>
          <li>Links must be contextually relevant and are subject to editorial approval.</li>
          <li>Paid promotional links are marked with <code>rel="sponsored"</code> (or <code>rel="nofollow"</code> where appropriate), in line with search engine guidelines.</li>
          <li>We don't accept links to gambling, casino, adult, pharmaceutical, payday loan, or other unsuitable promotional sites.</li>
        </ul>
      </section>

      <section aria-labelledby="images">
        <h2 id="images"><span class="hr"></span>Image Requirements</h2>
        <p>
          Relevant, high-quality, royalty-free images are welcome. By submitting images,
          you confirm that you have the rights to submit them and for us to publish them.
        </p>
      </section>

      <section aria-labelledby="submit">
        <h2 id="submit"><span class="hr"></span>Content Submission Instructions</h2>
        <ol class="wfu-steps">
          <li>
            <span class="wfu-steps__n">1</span>
            <h3>Prepare your article</h3>
            <p>Write a {gp.wordCount} word article that follows the guidelines above, plus a short author bio.</p>
          </li>
          <li>
            <span class="wfu-steps__n">2</span>
            <h3>Share the document</h3>
            <p>Google Docs is preferred — set sharing to “Anyone with the link – Viewer.” Word (.docx) files are accepted too.</p>
          </li>
          <li>
            <span class="wfu-steps__n">3</span>
            <h3>Email it to us</h3>
            <p>Send the link or file to <a href={mailto}>{siteConfig.email}</a>, along with any images you'd like included.</p>
          </li>
        </ol>
      </section>

      <section aria-labelledby="timeline">
        <h2 id="timeline"><span class="hr"></span>Editorial Review &amp; Publication Timeline</h2>
        <p>
          We review completed articles within {gp.reviewTime}. Publication is subject to
          editorial approval, and we may suggest edits so the piece fits our standards.
          Approved articles are intended to remain published long-term, subject to our
          editorial and payment terms.
        </p>
        <p>
          We can't promise search rankings, SEO benefits, or specific traffic — what we
          offer is a quality placement on a site built for real readers.
        </p>
      </section>

      <section aria-labelledby="payment">
        <h2 id="payment"><span class="hr"></span>Payment Terms</h2>
        <ul>
          <li>Sponsored publication rates are shared upon inquiry.</li>
          <li>Payment is due within {gp.paymentWindowHours} hours after publication.</li>
          <li>Articles with payment outstanding beyond that window may be unpublished until payment is received.</li>
          <li>Available payment methods can be confirmed during correspondence.</li>
        </ul>
      </section>

      <section aria-labelledby="faq">
        <h2 id="faq"><span class="hr"></span>Frequently Asked Questions</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p class="faq-item__answer">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>

    <section class="wfu-cta" aria-labelledby="cta">
      <h2 id="cta">Ready to submit your proposal?</h2>
      <p>
        Contact our editorial team at <a href={mailto}>{siteConfig.email}</a> for sponsored
        publication rates and submission details.
      </p>
      <a class="btn" href={mailto}>Inquire About Sponsored Posts</a>
    </section>
  </div>
</BaseLayout>

<style>
  .wfu-head-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 24px;
    margin-top: 24px;
  }
  .wfu-head-cta .btn { margin-top: 0; }
  .wfu-head-cta__email {
    font-family: var(--label);
    font-size: 14px;
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .wfu-head-cta__email:hover { color: var(--accent); }

  .wfu-top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
    padding-top: clamp(32px, 5vw, 56px);
  }
  .wfu-intro h2,
  .wfu-cta h2 {
    font-family: var(--display);
    font-weight: 420;
    font-size: clamp(26px, 3.2vw, 36px);
    line-height: 1.1;
    letter-spacing: -.01em;
  }
  .wfu-intro p {
    font-size: 19.5px;
    line-height: 1.72;
    color: var(--ink-soft);
    margin-top: 1.1em;
  }
  .wfu-note {
    margin-top: 1.6em;
    padding: 16px 20px;
    border-left: 3px solid var(--accent);
    background: var(--paper-2);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .wfu-note strong { color: var(--ink); }

  /* sponsored package card */
  .wfu-package {
    border: 1px solid var(--ink);
    border-radius: 2px;
    padding: clamp(24px, 3vw, 34px);
    background: var(--paper);
  }
  .wfu-package h3 {
    font-family: var(--display);
    font-weight: 440;
    font-size: 22px;
    line-height: 1.2;
    margin-top: 10px;
  }
  .wfu-package__list {
    list-style: none;
    margin-top: 14px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .wfu-package__list li {
    position: relative;
    padding: 6px 0 6px 22px;
    font-size: 16.5px;
    line-height: 1.4;
  }
  .wfu-package__list li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 13px;
    width: 9px;
    height: 5px;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }
  .wfu-package__ask { margin-top: 18px; }
  .wfu-package__ask p {
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .wfu-package__ask .wfu-package__q {
    font-family: var(--display);
    font-weight: 480;
    font-size: 19px;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .wfu-package__btn {
    display: block;
    text-align: center;
    margin-top: 20px;
    padding-inline: 12px;
    letter-spacing: .08em;
  }
  .wfu-package__email {
    margin-top: 14px;
    text-align: center;
    font-family: var(--label);
    font-size: 14px;
    color: var(--ink-soft);
  }
  .wfu-package__email a,
  .wfu-cta p a {
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* body sections */
  .wfu-body {
    max-width: 760px;
    margin-inline: auto;
    padding-top: clamp(12px, 2vw, 24px);
  }
  .wfu-body > section > * + * { margin-top: 1.1em; }

  .wfu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .wfu-body .wfu-cell {
    margin-top: 0;
    padding: 20px 22px;
    background: var(--paper-2);
    border-radius: 2px;
  }
  .wfu-body .wfu-cell h3 {
    margin-top: 0;
    font-size: 20px;
  }
  .wfu-body .wfu-cell p {
    margin-top: 8px;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .wfu-body .wfu-topics {
    columns: 2;
    column-gap: 32px;
  }
  .wfu-body .wfu-topics li { break-inside: avoid; }

  .wfu-body .wfu-steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .wfu-body .wfu-steps li {
    margin-top: 0;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .wfu-steps__n {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--label);
    font-weight: 700;
    font-size: 13px;
  }
  .wfu-body .wfu-steps h3 {
    margin-top: 14px;
    font-size: 20px;
  }
  .wfu-body .wfu-steps p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  /* closing CTA */
  .wfu-cta {
    max-width: 760px;
    margin: clamp(40px, 6vw, 72px) auto 0;
    padding: clamp(28px, 4vw, 44px);
    background: var(--paper-2);
    border-top: 3px solid var(--accent);
    text-align: center;
  }
  .wfu-cta p {
    margin: 14px auto 0;
    max-width: 46ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .wfu-cta .btn { margin-top: 22px; }

  @media (max-width: 860px) {
    .wfu-top { grid-template-columns: 1fr; }
    .wfu-body .wfu-steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .wfu-grid { grid-template-columns: 1fr; }
    .wfu-body .wfu-topics { columns: 1; }
  }
</style>
