---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import AdSlot from "../../../components/AdSlot.astro";
import Pagination from "../../../components/Pagination.astro";
import JsonLd from "../../../components/JsonLd.astro";
import { getSortedPosts, getAllAuthors } from "../../../utils/helpers";
import { siteConfig } from "../../../../site.config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  const authors = await getAllAuthors();
  return authors.flatMap((author) => {
    const filtered = posts
      .filter((p) => p.data.author === author.id)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    return paginate(filtered, {
      params: { author: author.id },
      props: { authorData: author.data, authorSlug: author.id, totalPosts: filtered.length },
      pageSize: siteConfig.postsPerPage,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { authorData, authorSlug, totalPosts } = Astro.props;

const avatar = authorData.avatar;

const initials = authorData.name
  .split(" ")
  .map((n: string) => n[0])
  .join("")
  .toUpperCase()
  .slice(0, 2);

const firstName = authorData.name.split(" ")[0];

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: authorData.name,
  url: `${siteConfig.siteUrl}/author/${authorSlug}/`,
  description: authorData.bio,
  ...(avatar ? { image: `${siteConfig.siteUrl}${avatar}` } : {}),
  ...(authorData.externalUrl ? { sameAs: [authorData.externalUrl] } : {}),
};
---

<BaseLayout
  title={page.currentPage > 1 ? `${authorData.name} — Page ${page.currentPage} — ${siteConfig.name}` : `${authorData.name} — ${siteConfig.name}`}
  description={`Articles by ${authorData.name} on ${siteConfig.name}. ${authorData.bio.split(".")[0]}.`.slice(0, 160)}
  noindex={page.currentPage > 1}
>
  {page.currentPage === 1 && <JsonLd data={personJsonLd} />}

  <div class="wrap">
    <section class="page-head">
      <p class="eyebrow">Author</p>
      {avatar ? (
        <img
          src={avatar}
          alt={authorData.name}
          style="width:80px;height:80px;margin:0 auto 1rem;border-radius:50%;object-fit:cover;"
        />
      ) : (
        <div
          class="av"
          style="width:80px;height:80px;font-size:1.8rem;margin:0 auto 1rem;border-radius:50%;background:var(--accent);color:var(--paper);display:grid;place-items:center;font-family:var(--label);font-weight:700;"
        >
          {initials}
        </div>
      )}
      <h1>{authorData.name}</h1>
      <p style="max-width:52ch;margin-inline:auto;">{authorData.bio}</p>
    </section>

    <AdSlot unit="display" />

    {page.data.length > 0 ? (
      <>
        <div class="shead">
          <h2>Articles by {firstName}</h2>
          <a href="/blog/">All stories &rarr;</a>
        </div>
        <div class="grid3">
          {page.data.map((post: any) => (
            <PostCard post={post} />
          ))}
        </div>
      </>
    ) : (
      <p class="muted" style="text-align:center;padding:2rem 0;">Articles by {authorData.name} coming soon.</p>
    )}

    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
  </div>
</BaseLayout>
