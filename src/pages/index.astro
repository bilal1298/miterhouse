---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import JsonLd from "../components/JsonLd.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../site.config";
import { formatDate, readingTime, getAuthorById, getAllCategories, getCategoryName, buildCategoryMap, getHeroImage } from "../utils/helpers";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = posts[0];
const gridPosts = posts.slice(1, 4);
const mostRead = posts.slice(4, 8);

const categories = await getAllCategories();
const catMap = await buildCategoryMap();

const shownIds = new Set(posts.slice(0, 8).map(p => p.id));

type Spotlight = { cat: typeof categories[0]; posts: typeof posts };
const spotlights: Spotlight[] = categories
  .map(cat => ({ cat, remaining: posts.filter(p => p.data.category === cat.id && !shownIds.has(p.id)) }))
  .filter(c => c.remaining.length >= 3)
  .sort((a, b) => b.remaining.length - a.remaining.length)
  .map(({ cat, remaining }) => {
    const picks = remaining.slice(0, 3);
    picks.forEach(p => shownIds.add(p.id));
    return { cat, posts: picks };
  });

const categoryBrowse = categories
  .map(cat => ({ cat, count: posts.filter(p => p.data.category === cat.id).length }))
  .filter(c => c.count > 0)
  .sort((a, b) => b.count - a.count);

const featuredAuthor = featured ? await getAuthorById(featured.data.author) : undefined;
const featuredAuthorName = featuredAuthor?.data.name || featured?.data.author || "";
const featuredAuthorAvatar = featuredAuthor?.data.avatar;

function initials(name: string) {
  return name
    .split(" ")
    .map((w) => w[0])
    .join("")
    .toUpperCase()
    .slice(0, 2);
}

const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  description: siteConfig.description,
};
---

<BaseLayout title={`${siteConfig.name} — ${siteConfig.tagline}`} description={siteConfig.description}>
  <JsonLd data={webSiteJsonLd} />

  {featured && (
    <section class="hero wrap">
      <a href={`/blog/${featured.id}/`} class="hero__grid">
        <div class="hero__body reveal d2">
          <span class="kicker">{catMap.get(featured.data.category)?.data.name || featured.data.category}</span>
          <h1>{featured.data.title.split(" ").length > 4
            ? <>
                {featured.data.title.split(" ").slice(0, Math.floor(featured.data.title.split(" ").length / 2)).join(" ")}{" "}
                <em>{featured.data.title.split(" ").slice(Math.floor(featured.data.title.split(" ").length / 2)).join(" ")}</em>
              </>
            : featured.data.title
          }</h1>
          <p class="hero__dek">{featured.data.description}</p>
          <div class="byline">
            {featuredAuthorAvatar ? (
              <img src={featuredAuthorAvatar} alt={featuredAuthorName} class="av av--img" />
            ) : (
              <span class="av">{initials(featuredAuthorName)}</span>
            )}
            <span>By <b>{featuredAuthorName}</b></span>
            <span class="sep"></span>
            <span>{readingTime(featured.body)} min read</span>
          </div>
        </div>
        <div class="hero__media reveal d3">
          {getHeroImage(featured) ? (
            <img src={getHeroImage(featured)} alt={featured.data.title} loading="eager" />
          ) : (
            <div class="ph"></div>
          )}
        </div>
      </a>
    </section>
  )}

  <div class="wrap">

    <div class="shead">
      <h2>From the journal</h2>
      <a href="/blog/">All stories &rarr;</a>
    </div>

    <div class="feature">
      <div>
        {gridPosts.length > 0 ? (
          <div class="grid3">
            {gridPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="grid3">
            <PostCard post={featured} />
          </div>
        )}
      </div>

      <aside>
        <div class="shead" style="padding-top:0;border-bottom:1px solid var(--ink)">
          <h2 style="font-size:22px">Most read</h2>
        </div>
        <div class="sidelist">
          {mostRead.map((post, i) => (
            <a href={`/blog/${post.id}/`}>
              <div class="sideitem">
                <div class="num">{String(i + 1).padStart(2, "0")}</div>
                <div>
                  <div class="kicker">{catMap.get(post.data.category)?.data.name || post.data.category}</div>
                  <h4>{post.data.title}</h4>
                </div>
              </div>
            </a>
          ))}
        </div>
      </aside>
    </div>


    {spotlights.map((s) => (
      <>
        <div class="shead">
          <h2>{s.cat.data.name}</h2>
          <a href={`/category/${s.cat.id}/`}>More &rarr;</a>
        </div>
        <div class="grid3" style="margin-top:clamp(34px,5vw,52px)">
          {s.posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </>
    ))}

    {categoryBrowse.length > 0 && (
      <>
        <div class="shead">
          <h2>Browse by category</h2>
          <a href="/categories/">All categories &rarr;</a>
        </div>
        <div class="cat-browse">
          {categoryBrowse.map((c) => (
            <a href={`/category/${c.cat.id}/`} class="cat-card">
              <h3>{c.cat.data.name}</h3>
              <span>{c.count} {c.count === 1 ? 'article' : 'articles'}</span>
            </a>
          ))}
        </div>
      </>
    )}

  </div>

  <section id="newsletter" class="band">
    <div class="wrap">
      <div>
        <span class="kicker">The weekly update</span>
        <h2>One <em>practical guide</em>, in your inbox each week.</h2>
      </div>
      <div>
        <p>No noise, no fluff. Just the single most useful home improvement guide we published this week.</p>
        <form id="newsletter-form" class="form" method="POST" action="https://n8n.pracxcel.com.au/webhook/miter-house-newsletter">
          <input type="email" name="email" placeholder="your@email.com" aria-label="Email address" required />
          <!-- honeypot -->
          <div style="position:absolute;left:-9999px" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="cf-turnstile" data-sitekey={siteConfig.turnstileSiteKey} data-size="invisible"></div>
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </div>
  </section>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const data = new FormData(form);
        await fetch(form.action, { method: 'POST', body: data });
        window.location.href = '/thank-you-newsletter/';
      } catch {
        btn.disabled = false;
        btn.textContent = 'Subscribe';
        alert('Something went wrong. Please try again.');
      }
    });
  </script>

</BaseLayout>
