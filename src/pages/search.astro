---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../site.config";
import { buildCategoryMap, buildTagMap } from "../utils/helpers";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const catMap = await buildCategoryMap();
const tagMap = await buildTagMap();

const searchData = posts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  slug: p.id,
  category: catMap.get(p.data.category)?.data.name || p.data.category,
  tags: p.data.tags.map((t) => tagMap.get(t)?.data.name || t),
}));
---

<BaseLayout title={`Search — ${siteConfig.name}`} description={`Search all articles on ${siteConfig.name}.`} noindex>
  <div class="wrap">
    <section class="page-head" style="padding-block:3rem">
      <p class="eyebrow">Search</p>
      <h1>Find an article</h1>
      <div id="search" style="margin-top:1.5rem;max-width:48ch;margin-inline:auto;">
        <input
          type="search"
          id="search-input"
          placeholder="Type to search..."
          autocomplete="off"
          style="width:100%;padding:.75rem 1rem;font-family:var(--label);font-size:1rem;border:1px solid var(--line);border-radius:4px;background:var(--paper-2);color:var(--ink);outline:none;"
        />
      </div>
      <div id="search-results" style="margin-top:2rem;"></div>
    </section>
  </div>

  <script define:vars={{ searchData }}>
    const input = document.getElementById("search-input");
    const resultsEl = document.getElementById("search-results");

    input.addEventListener("input", () => {
      const q = input.value.toLowerCase().trim();
      if (q.length < 2) {
        resultsEl.innerHTML = "";
        return;
      }
      const matches = searchData.filter(
        (p) =>
          p.title.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.tags.some((t) => t.toLowerCase().includes(q))
      );
      resultsEl.innerHTML = matches.length
        ? `<div style="max-width:680px;margin-inline:auto;">${matches
            .map(
              (p) =>
                `<div style="padding:1.25rem 0;border-top:1px solid var(--line);">
                  <span style="font-family:var(--label);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);">${p.category}</span>
                  <h3 style="font-family:var(--display);font-size:1.2rem;margin:.25rem 0;">
                    <a href="/blog/${p.slug}/" style="color:var(--ink);">${p.title}</a>
                  </h3>
                  <p style="color:var(--ink-soft);font-size:.95rem;">${p.description}</p>
                </div>`
            )
            .join("")}</div>`
        : '<p style="color:var(--muted);margin-top:1rem;">No articles found.</p>';
    });
  </script>
</BaseLayout>
