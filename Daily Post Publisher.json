    {
      "parameters": {
        "jsCode": "const content = $json.content;\n  const sha = $json.sha;\n  const name = $json.name; // e.g. \"1980s-home-renovation.md\"\n\n  if (!content) {\n    throw new Error('No file content returned from GitHub');\n  }\n  \n  const decoded = Buffer.from(content, 'base64').toString('utf-8');\n\n  const updated = decoded.replace(/^(---[\\s\\S]*?)draft:\\s*true/m, '$1draft: false');\n\n  if (updated === decoded) {\n    throw new Error('Could not find draft: true in frontmatter — file may already be published');\n  }\n\n  const slug = name.replace('.md', '');\n                               \n  return [{\n    json: {\n      updatedContent: updated,\n      sha: sha,\n      slug: slug\n    }\n  }];"
      },
